SESSION_SECRET=

# Turso (hosted libSQL/SQLite) — from your database's page on turso.tech,
# or `turso db show <name>` / `turso db tokens create <name>`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob — from the project's Storage tab on vercel.com once a Blob
# store is connected (also needed locally, not just in production).
BLOB_READ_WRITE_TOKEN=

# Only used once, to seed the first admin_users row when the DB is empty.
# Safe to delete these two lines after the first successful login.
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=

# Contact form email (GoDaddy Workspace Email SMTP via Nodemailer).
# SMTP_HOST/PORT come from GoDaddy's Email & Office settings for the mailbox.
# SMTP_PASSWORD is that mailbox's actual login password.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
CONTACT_ADMIN_EMAIL=

# How long (ms) the "ON AIR" confirmation shows before the contact form
# reappears. Must be NEXT_PUBLIC_ since it's read in the browser.
NEXT_PUBLIC_CONTACT_SUCCESS_DURATION_MS=6000
